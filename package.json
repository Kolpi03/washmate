{
  "name": "washmate",
  "version": "1.0.0",
  "private": true,
  "description": "WashMate – Smart Hostel Laundry Management System",
  "scripts": {
    "install:all": "npm --prefix frontend install && npm install",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "test:frontend": "node --test tests/frontend/",
    "demo:serve": "bash demo/serve-demo.sh",
    "demo:record": "node tests/e2e/demo.spec.js"
  },
  "devDependencies": {
    "playwright": "^1.49.1"
  }
}
