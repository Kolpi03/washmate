# Copy to .env for local development. NEVER commit real values.
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# Leave empty locally to use SQLite (backend/instance/washmate.db).
# Production: hosted PostgreSQL (e.g. Neon) connection string.
DATABASE_URL=
FRONTEND_URL=http://localhost:5173
# Frontend build-time API base. Leave empty for same-origin (/api) which is
# correct for both the Vite dev proxy and the Vercel deployment.
VITE_API_URL=
# Operator-configured payment target (can also be edited in the Operator > Settings page)
UPI_ID=hostel.laundry@upi
UPI_QR_CODE_URL=
# Bearer token protecting /api/cron/reminders (Vercel Cron sends it automatically as CRON_SECRET)
CRON_SECRET=change-me-cron
# Used only by `python backend/manage.py create-operator` if not passed as arguments
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
